{
  "name": "@sker/bigscreen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec vite --port 9088",
    "build": "pnpm exec vite build",
    "build:cloudflare": "tsx scripts/build-cloudflare.ts",
    "deploy": "pnpm run build && pnpx wrangler@latest deploy",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-checks": "tsc --noEmit 2>&1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sker/core": "workspace:*",
    "@sker/entities": "workspace:*",
    "@sker/sdk": "workspace:*",
    "@sker/ui": "workspace:*",
    "@sker/workflow": "workspace:*",
    "@sker/workflow-ast": "workspace:*",
    "@sker/workflow-browser": "workspace:*",
    "@sker/workflow-ui": "workspace:*",
    "@types/three": "^0.185.3",
    "axios": "1.7.9",
    "clsx": "^2.0.0",
    "d3-force-3d": "^3.0.6",
    "dayjs": "^1.11.10",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "framer-motion": "^12.23.24",
    "lucide-react": "^1.28.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-3d": "^1.29.0",
    "react-router-dom": "^7.18.2",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "vis-network": "^10.0.2",
    "web-vitals": "^6.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@sker/eslint-config": "workspace:*",
    "@sker/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/vite": "^4.1.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-react-swc": "^4.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.5",
    "terser": "^5.44.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-swc-transform": "^1.1.1",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
