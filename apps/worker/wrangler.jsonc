{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weibo-proxy-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "67720b647ff2b55cf37ba3ef9e677083",

  // 可观测性配置
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },

  // 浏览器渲染绑定
  "browser": {
    "binding": "BROWSER"
  }
}
