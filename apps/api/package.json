{
  "name": "@sker/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "start:prod": "node dist/main",
    "pm2:start": "pm2 start dist/main.js --name sker-api",
    "pm2:stop": "pm2 stop sker-api",
    "pm2:restart": "pm2 restart sker-api",
    "pm2:delete": "pm2 delete sker-api",
    "pm2:logs": "pm2 logs sker-api",
    "pm2:monit": "pm2 monit",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "postinstall": "pnpx playwright install",
    "test": "vitest",
    "test:event": "tsx src/scripts/test-event-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
