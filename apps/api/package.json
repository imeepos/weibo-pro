    "@sker/chat": "workspace:*",
    "@sker/core": "workspace:*",
    "@sker/entities": "workspace:*",
    "@sker/ip-proxy": "workspace:*",
    "@sker/llm-protocol": "workspace:*",
    "@sker/mq": "workspace:*",
    "@sker/redis": "workspace:*",
    "@sker/sdk": "workspace:*",
    "@sker/utils": "workspace:*",
    "@sker/workflow": "workspace:*",
    "@sker/workflow-ast": "workspace:*",
    "@sker/workflow-compiler": "workspace:*",
    "@sker/workflow-run": "workspace:*",
    "axios": "^1.6.0",
    "better-auth": "^1.4.8",
    "busboy": "^1.6.0",
    "cron-parser": "^5.4.0",
    "dotenv": "^16.4.7",
    "hono": "^4.11.1",
    "kill-port-process": "^3.2.1",
    "node-cron": "^4.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0",
    "zod": "^4.2.1"
