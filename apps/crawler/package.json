{
  "name": "@sker/crawler",
  "version": "0.0.1",
  "private": true,
  "description": "Crawler service that consumes MQ tasks and executes crawling workflows",
  "scripts": {
    "dev": "tsx src/main.ts --watch",
    "build": "tsc",
    "start": "node --expose-gc --max-old-space-size=1024 dist/main.js",
    "start:prod": "node --expose-gc --max-old-space-size=1024 dist/main",
    "pm2:start": "pm2 start dist/main.js --name sker-crawler --node-args=\"--expose-gc --max-old-space-size=1024\"",
    "pm2:stop": "pm2 stop sker-crawler",
    "pm2:restart": "pm2 restart sker-crawler",
    "pm2:delete": "pm2 delete sker-crawler",
    "pm2:logs": "pm2 logs sker-crawler",
    "pm2:monit": "pm2 monit",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@sker/core": "workspace:*",
    "@sker/entities": "workspace:*",
    "@sker/workflow": "workspace:*",
    "@sker/workflow-ast": "workspace:*",
    "@sker/workflow-run": "workspace:*",
    "cron-parser": "^5.4.0",
    "dotenv": "^17.4.2",
    "node-schedule": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/node-schedule": "^2.1.8",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
