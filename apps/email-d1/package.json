{
  "name": "@sker/email-d1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpx wrangler@latest dev",
    "deploy": "pnpx wrangler@latest deploy",
    "d1:create": "pnpx wrangler@latest d1 create email-db",
    "d1:execute": "pnpx wrangler@latest d1 execute email-db --file=./schema.sql",
    "d1:execute-remote": "pnpx wrangler@latest d1 execute email-db --remote --file=./schema.sql",
    "check": "powershell -ExecutionPolicy Bypass -File ./check-config.ps1",
    "tail": "pnpx wrangler@latest tail",
    "db:query": "pnpx wrangler@latest d1 execute email-db --remote --command",
    "db:list": "pnpx wrangler@latest d1 execute email-db --remote --command \"SELECT * FROM emails ORDER BY received_at DESC LIMIT 10\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "wrangler": "^4.118.0"
  }
}
