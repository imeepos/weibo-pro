    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sker/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^11.0.0",
    "tsup": "^8.4.0",
    "typescript": "5.9.2"
