{
  "name": "@sker/nlp",
  "version": "0.0.0",
  "private": true,
  "description": "LLM client library with OpenAI-compatible API support.",
  "keywords": [
    "llm",
    "openai",
    "nlp",
    "sker"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "claude": "claude --dangerously-skip-permissions",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@sker/core": "workspace:*",
    "@sker/ip-proxy": "workspace:*",
    "@sker/json-harmony": "workspace:*",
    "https-proxy-agent": "^9.1.0",
    "openai": "^7.3.0"
  },
  "devDependencies": {
    "@sker/eslint-config": "workspace:*",
    "@sker/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  }
}
