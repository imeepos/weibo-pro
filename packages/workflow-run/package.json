{
  "name": "@sker/workflow-run",
  "version": "0.0.0",
  "private": true,
  "description": "Backend runtime execution for workflow nodes.",
  "keywords": [
    "workflow",
    "runtime",
    "backend",
    "execution",
    "sker"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "claude": "claude --dangerously-skip-permissions",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "main": "tsx src/main.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.0.4",
    "@langchain/openai": "^1.1.0",
    "@langchain/tavily": "^1.0.0",
    "@sker/core": "workspace:*",
    "@sker/entities": "workspace:*",
    "@sker/ip-proxy": "workspace:*",
    "@sker/json-harmony": "workspace:*",
    "@sker/nlp": "workspace:*",
    "@sker/redis": "workspace:*",
    "@sker/sdk": "workspace:*",
    "@sker/workflow": "workspace:*",
    "@sker/workflow-ast": "workspace:*",
    "cheerio": "^1.1.2",
    "cron-parser": "^5.4.0",
    "dayjs": "^1.11.13",
    "deepagents": "^1.1.1",
    "exceljs": "^4.4.0",
    "execa": "^10.0.1",
    "langchain": "^1.0.4",
    "marked": "^18.0.7",
    "node-schedule": "^2.1.1",
    "playwright": "^1.56.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@sker/eslint-config": "workspace:*",
    "@sker/typescript-config": "workspace:*",
    "@sker/workflow-compiler": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/node-schedule": "^2.1.7",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^10.8.0",
    "glob": "^13.0.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
