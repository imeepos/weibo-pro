{
  "name": "@sker/entities",
  "version": "0.0.0",
  "private": true,
  "description": "TypeORM entities and database models for Sker applications.",
  "keywords": [
    "entities",
    "database",
    "typeorm",
    "sker"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "types": "./dist/browser/browser.d.ts",
        "import": "./dist/browser/browser.mjs"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "browser": "./dist/browser.mjs",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "claude": "claude --dangerously-skip-permissions",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "stats": "tsx scripts/run-user-relation-stats.ts",
    "timezone-fix:preview": "tsx scripts/run-timezone-fix.ts preview",
    "timezone-fix": "tsx scripts/run-timezone-fix.ts fix",
    "import-sql-backup": "tsx scripts/import-sql-backup.ts"
  },
  "dependencies": {
    "@sker/core": "workspace:*",
    "@sker/redis": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@sker/eslint-config": "workspace:*",
    "@sker/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
