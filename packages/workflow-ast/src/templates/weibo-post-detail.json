{
  "name": "微博博文详情",
  "description": "使用 HttpRequestAst 获取微博博文详情",
  "node": "HttpRequestAst",
  "config": {
    "method": "GET",
    "urlTemplate": "https://weibo.com/ajax/statuses/show",
    "queryParams": {
      "id": "{{mblogid}}"
    },
    "headers": {
      "Cookie": "{{cookie}}"
    }
  }
}
