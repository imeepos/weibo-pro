{
  "name": "微博关键词搜索",
  "description": "使用 HttpRequestAst 实现微博关键词搜索",
  "node": "HttpRequestAst",
  "config": {
    "method": "GET",
    "urlTemplate": "https://weibo.com/ajax/side/search",
    "queryParams": {
      "q": "{{keyword}}",
      "page": "{{page}}"
    },
    "headers": {
      "Cookie": "{{cookie}}"
    }
  }
}
