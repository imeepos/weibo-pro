{
  "name": "@sker/workflow-browser",
  "version": "0.0.0",
  "type": "module",
  "description": "Browser runtime execution for workflow nodes.",
  "keywords": [
    "workflow",
    "runtime",
    "browser",
    "frontend",
    "execution",
    "sker"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "claude": "claude --dangerously-skip-permissions",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sker/core": "workspace:*",
    "@sker/workflow": "workspace:*",
    "@sker/sdk": "workspace:*",
    "@sker/workflow-ast": "workspace:*",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@sker/eslint-config": "workspace:*",
    "@sker/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
