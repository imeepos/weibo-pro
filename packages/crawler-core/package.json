{
  "name": "@sker/crawler-core",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP client and core utilities for web crawling",
  "keywords": [
    "crawler",
    "http-client",
    "axios"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "migration:generate": "typeorm migration:generate -d ormconfig.ts",
    "migration:run": "typeorm migration:run -d ormconfig.ts",
    "migration:revert": "typeorm migration:revert -d ormconfig.ts"
  },
  "devDependencies": {
    "@sker/eslint-config": "workspace:*",
    "@sker/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "^9.38.0",
    "tsup": "^8.4.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@sker/core": "workspace:*",
    "@sker/entities": "workspace:*",
    "@sker/mq": "workspace:*",
    "@sker/nlp": "workspace:*",
    "@sker/workflow": "workspace:*",
    "axios": "^1.7.9",
    "cron": "^4.4.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.49.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socks-proxy-agent": "^10.1.0",
    "tough-cookie": "^6.0.2",
    "typeorm": "^0.3.20"
  }
}
