OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=your_openai_api_key_here

DATABASE_URL=postgresql://postgres:password@localhost:5432/vectordb
AMAP_API_KEY=your_amap_api_key_here
REDIS_URL=redis://:password@localhost:6379
RABBITMQ_URL=amqp://admin:password@localhost:5672
MONGODB_URL=mongodb://admin:password@localhost:27017/appdb?authSource=admin

# 工作流节点并发控制（RxJS Scheduler）
CRAWLER_CONCURRENCY=1                # 工作流节点最大并发数（默认1，串行执行）

# 微博爬虫限流配置（防止 403 封号）
# 全局限流：所有请求的总速率（令牌桶算法）
WEIBO_GLOBAL_RATE_CAPACITY=2        # 令牌桶容量（允许突发请求数）
WEIBO_GLOBAL_RATE_REFILL=1          # 令牌补充速率（请求/秒）

# 账号级限流：每个账号的请求速率
WEIBO_ACCOUNT_RATE_CAPACITY=1       # 账号令牌桶容量
WEIBO_ACCOUNT_RATE_REFILL=0.5       # 账号令牌补充速率（每2秒1个请求）

# 请求间延迟（秒）
WEIBO_REQUEST_DELAY_MIN=1           # 每次请求后最小延迟
WEIBO_REQUEST_DELAY_MAX=3           # 每次请求后最大延迟

# 翻页延迟（秒）
WEIBO_PAGE_DELAY_MIN=3              # 翻页最小延迟
WEIBO_PAGE_DELAY_MAX=5              # 翻页最大延迟

# ==================== 并发控制说明 ====================
# 本项目采用双层限流架构防止微博封号：
#
# 1. 节点级并发控制（CRAWLER_CONCURRENCY）
#    - 控制工作流中同时执行的节点数量
#    - 默认 1：所有节点串行执行（最安全）
#    - 推荐 1-2：适合爬虫场景
#
# 2. 请求级限流（WEIBO_*）
#    - 令牌桶算法控制单个节点内的请求速率
#    - 账号级退避策略：失败自动降速
#    - 随机延迟：模拟人类行为
#
# 调优建议：
# - 遇到 403：降低 CRAWLER_CONCURRENCY 至 1
# - 提速（风险自负）：提高至 2-3
# - 详见 packages/workflow-run/RATE_LIMITING.md
