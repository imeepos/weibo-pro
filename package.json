{
  "name": "sker",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "cc": "claude  --dangerously-skip-permissions",
    "build:force": "turbo run build --force --no-cache",
    "build:deps": "pnpm run -r --filter=\"./packages/*\" build",
    "dev": "turbo run dev --concurrency=23",
    "dev:robust": "./scripts/ensure-deps-built.sh && turbo run dev --concurrency=23",
    "dev:clean": "./scripts/dev-with-port-guardian.sh",
    "port:guardian": "./scripts/port-guardian.sh",
    "storybook": "turbo run dev --filter=@sker/storybook",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "ensure-deps": "./scripts/ensure-deps-built.sh",
    "clean:cache": "tsx ./scripts/clean-cache.ts"
  },
  "devDependencies": {
    "@types/minimatch": "^6.0.0",
    "@types/node-schedule": "^2.1.8",
    "@vitest/ui": "^4.0.16",
    "minimatch": "^10.1.1",
    "node-schedule": "^2.1.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "5.9.3",
    "vitest": "^4.0.16",
    "zod": "^4.2.1"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-auth": "^1.4.8",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-types": "^0.24.8",
    "pg": "^8.16.3"
  },
  "pnpm": {
    "overrides": {
      "csstype": "^3.2.3",
      "@types/react": "^19.0.0",
      "three": "0.181.1",
      "react": "^19.1.1",
      "react-dom": "^19.1.1",
      "zod": "^4.2.1",
      "echarts": "^6.0.0",
      "canvas": "npm:empty-package@1.0.0",
      "vitest": "^4.0.16",
      "@vitest/ui": "^4.0.16",
      "@vitest/runner": "^4.0.16",
      "@vitest/utils": "^4.0.16",
      "better-call": "1.1.8",
      "@better-auth/passkey": "1.4.13",
      "@better-auth/sso": "1.4.13",
      "@svta/cml-utils": "1.1.0",
      "@svta/cml-cta": "1.0.2",
      "@svta/cml-structured-field-values": "1.0.2",
      "sass": "^1.70.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "canvas",
        "mongodb"
      ],
      "allowedVersions": {
        "mongodb": "7",
        "better-call": "1.1.8",
        "@better-auth/core": "1.4.13"
      }
    }
  }
}
